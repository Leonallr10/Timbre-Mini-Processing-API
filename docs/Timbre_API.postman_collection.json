{
  "info": {
    "_postman_id": "timbre-mini-processing-api",
    "name": "Timbre Mini Processing API",
    "description": "Upload media assets and run simulated processing jobs (transcription, noise_reduction).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "assetId",
      "value": ""
    },
    {
      "key": "jobId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        }
      }
    },
    {
      "name": "Upload asset",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) {",
              "  const body = pm.response.json();",
              "  pm.collectionVariables.set('assetId', body.id);",
              "  console.log('Saved assetId:', body.id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": null,
              "description": "Select an audio/video file in Postman before sending. Do not leave an empty path in src."
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/assets",
          "host": ["{{baseUrl}}"],
          "path": ["assets"]
        }
      }
    },
    {
      "name": "Get asset",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/assets/{{assetId}}",
          "host": ["{{baseUrl}}"],
          "path": ["assets", "{{assetId}}"]
        }
      }
    },
    {
      "name": "Start processing (transcription)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 202) {",
              "  const body = pm.response.json();",
              "  pm.collectionVariables.set('jobId', body.id);",
              "  console.log('Saved jobId:', body.id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"operation\": \"transcription\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/assets/{{assetId}}/process",
          "host": ["{{baseUrl}}"],
          "path": ["assets", "{{assetId}}", "process"]
        }
      }
    },
    {
      "name": "Start processing (noise_reduction)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 202) {",
              "  const body = pm.response.json();",
              "  pm.collectionVariables.set('jobId', body.id);",
              "  console.log('Saved jobId:', body.id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"operation\": \"noise_reduction\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/assets/{{assetId}}/process",
          "host": ["{{baseUrl}}"],
          "path": ["assets", "{{assetId}}", "process"]
        }
      }
    },
    {
      "name": "Get job",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/jobs/{{jobId}}",
          "host": ["{{baseUrl}}"],
          "path": ["jobs", "{{jobId}}"]
        }
      }
    },
    {
      "name": "List jobs for asset",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/assets/{{assetId}}/jobs",
          "host": ["{{baseUrl}}"],
          "path": ["assets", "{{assetId}}", "jobs"]
        }
      }
    }
  ]
}
